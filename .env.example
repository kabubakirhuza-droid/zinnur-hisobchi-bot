# Токен вашего Telegram-бота (от @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# ID вашей Google Таблицы (из адресной строки браузера)
# Пример: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit -> ID: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Название вкладки в Google Таблице (по умолчанию: Sheet1 или Лист1)
SPREADSHEET_SHEET_NAME=Лист1

# Путь к файлу ключа сервисного аккаунта Google (Service Account JSON)
# Положите скачанный файл credentials.json в корень проекта или укажите путь
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Часовой пояс для фиксации даты и времени (по умолчанию: Asia/Tashkent)
TIMEZONE=Asia/Tashkent
